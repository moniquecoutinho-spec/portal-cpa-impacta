# =============================================================================
# Portal CPA — modelo de variáveis de ambiente.
# Copie para ".env" e preencha com os dados do seu projeto Supabase:
#   cp .env.example .env
# Valores em: Supabase Dashboard > Project Settings > API Keys / Database
# =============================================================================

# --- Supabase: API ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Chave pública: pode ir para o front-end (a proteção real é a RLS)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Chave secreta: SOMENTE no backend Flask. Ignora a RLS. Nunca expor.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Usada pelo Flask para validar os tokens JWT emitidos pelo Supabase Auth
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Supabase: conexão com o PostgreSQL ---
# Recomendado: pooler (funciona em IPv4). Dashboard > Connect > Session pooler.
#   Porta 5432 = modo sessão (desenvolvimento local)
#   Porta 6543 = modo transação (hospedagem serverless, ex.: Vercel)
# Alternativa: host direto db.<project-ref>.supabase.co com usuário "postgres"
# (só funciona em redes com IPv6).
SUPABASE_DB_HOST=aws-1-<regiao>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=
# Opcional: URL completa; se definida, substitui as variáveis SUPABASE_DB_* acima
# DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-1-<regiao>.pooler.supabase.com:6543/postgres

# --- Flask ---
FLASK_APP=app
FLASK_DEBUG=1
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=troque-por-um-valor-aleatorio

# --- Página de contato (opcionais) ---
# CPA_LINK_CHAT=https://chat.google.com/room/<id-da-sala>
# CPA_LINK_MEET=https://meet.google.com/<codigo>
# CPA_EMAIL=cpa@faculdadeimpacta.edu.br
